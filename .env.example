# Alibaba Model Studio / QwenCloud API key (pay-as-you-go).
# Get one here: https://modelstudio.console.alibabacloud.com  (Singapore region works fine)
DASHSCOPE_API_KEY=sk-your-key-here

# Optional:
# OMNI_LANG=en                 # answer language: en, pl, de, es, fr
# OMNI_MODEL=qwen3.8-omni-flash
# DASHSCOPE_API=https://dashscope-intl.aliyuncs.com   # region endpoint
# OMNI_CACHE_HOURS=48          # how long downloaded videos stay on your disk
# OMNI_PART_MINUTES=40         # longer videos are split into parts of this length
